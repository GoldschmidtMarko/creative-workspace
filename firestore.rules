rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // User profiles + account data. The client may read its own profile;
    // all writes go through the backend (Admin SDK bypasses these rules).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Analysis progress documents, read by the client via onSnapshot.
    // Ephemeral, non-sensitive; written only by the backend.
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else — scraping caches, rateLimits, etc. — is backend-only.
    // (The Admin SDK bypasses rules, so functions can still read/write these.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
